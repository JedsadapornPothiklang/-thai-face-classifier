# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── Azure Cognitive Services – Face API ──────────────────────────────────────
# Get these from: Azure Portal → Your Face resource → Keys and Endpoint
AZURE_FACE_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com
AZURE_FACE_API_KEY=your_azure_face_api_key_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
# The URL of your frontend (no trailing slash)
ALLOWED_ORIGIN=http://localhost:5173
